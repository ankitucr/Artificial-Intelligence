import asyncio
from pathlib import Path

from core.brain import PIKABrain
from core.semantic_code_memory import SemanticCodeMemory
from tests.test_phase34_brain_integration import (
    FakeMemory, FakeAnalyzer, FakePlanner, FakeDecision,
    FakeAgent, FakeRouter, FakeWorkspaceExecutor, FakePhase32,
    FakePhase33,
)


class EmptyLearning:
    def lookup_candidates(self, **kwargs):
        return []


class FakeExperience:
    def create_experience(self, **kwargs):
        return {"lesson": "isolated Phase 35 memory reuse test"}


class GeneratorMustNotRun:
    async def generate_from_failure(self, **kwargs):
        raise AssertionError(
            "Generator ran despite a successful verified semantic-memory repair"
        )


async def main():
    db = Path("data/semantic_code_memory.json").resolve()
    memory = SemanticCodeMemory(db)
    expected = "return price * (1 - percent / 100)"

    hits = memory.retrieve(
        "Fix percentage discount calculation",
        verified_only=True,
    )
    assert any(expected in item["code"] for item in hits), hits
    assert all(
        item["verification"] in {"test_verified", "formally_verified"}
        for item in hits
    )

    agent = FakeAgent()
    brain = PIKABrain(
        router=FakeRouter(agent),
        memory=FakeMemory(),
        planner=FakePlanner(),
        evaluator=object(),
        experience=FakeExperience(),
        task_analyzer=FakeAnalyzer(),
        decision_engine=FakeDecision(),
        tool_runtime=None,
        max_retries=0,
    )

    brain.tool_runtime = object()
    brain.workspace_executor = FakeWorkspaceExecutor()
    brain.phase32_controller = FakePhase32()
    brain.phase34_learning = EmptyLearning()
    brain.phase33_controller = FakePhase33()
    brain.repair_candidate_generator = GeneratorMustNotRun()
    brain.semantic_code_memory = memory

    result = await brain.think(
        "Fix discount calculation: percentage must be applied to original price"
    )

    assert result.get("success") is True, result
    assert result.get("phase33_repair", {}).get("success") is True, result

    calls = brain.phase33_controller.calls
    assert len(calls) == 1, calls
    candidates = calls[0]["candidates"]
    assert expected in candidates, candidates

    # This integration test must not add/promote production memory records.
    reloaded = SemanticCodeMemory(db)
    stored = [v for v in reloaded.data["variants"] if expected in v["code"]]
    assert stored, "Production memory record disappeared"
    assert all(
        v["verification"] in {"test_verified", "formally_verified"}
        for v in stored
    )

    print("\nPHASE 35 PRODUCTION MEMORY REUSE: PASS")
    print("Verified: real production memory was read.")
    print("Verified: saved discount solution reached Phase 33.")
    print("Verified: unverified entries cannot enter verified retrieval.")
    print("Verified: candidate generator was not called.")
    print("Verified: production memory remains verified.")


if __name__ == "__main__":
    asyncio.run(main())
