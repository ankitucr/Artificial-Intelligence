def create_plan(user_task, goals):
    build_graph()

    contracts = build_all()
    registry = load_registry()

    # -------------------------------------------------
    # Select the best capability for each requested goal.
    # Preserve goal order.
    # -------------------------------------------------

    selected = []

    for goal in goals:

        skill = choose_skill_for_goal(
            goal
        )

        if (
            skill
            and skill in registry
            and skill in contracts
            and skill not in selected
        ):
            selected.append(
                skill
            )

    if not selected:
        return {
            "query": user_task,
            "steps": [],
            "planner": "dependency_solver"
        }

    # -------------------------------------------------
    # Add required producer skills, but never create
    # dependencies for root inputs such as "text".
    # -------------------------------------------------

    changed = True

    while changed:

        changed = False

        for skill in list(selected):

            inputs = contracts.get(
                skill,
                {}
            ).get(
                "inputs",
                {}
            )

            for required_field in inputs:

                if str(required_field).lower() in {
                    "text",
                    "input",
                    "query",
                    "user_input",
                }:
                    continue

                producers = producer_candidates(
                    required_field,
                    contracts,
                    exclude=skill
                )

                for producer, _ in producers:

                    if (
                        producer in registry
                        and producer not in selected
                    ):
                        selected.append(
                            producer
                        )
                        changed = True
                        break

    # -------------------------------------------------
    # Dependency graph
    # -------------------------------------------------

    dependencies = build_dependency_graph(
        selected,
        contracts
    )

    # -------------------------------------------------
    # Apply semantic workflow precedence.
    # -------------------------------------------------

    dependencies = apply_semantic_precedence(
        selected,
        dependencies,
        user_task
    )

    # -------------------------------------------------
    # Remove false generic-text cycles.
    # -------------------------------------------------

    for skill in list(dependencies):
        dependencies[skill].discard(skill)

    ordered = topological_order(
        selected,
        dependencies
    )

    step_numbers = {
        skill: index + 1
        for index, skill in enumerate(
            ordered
        )
    }

    # -------------------------------------------------
    # Build exact step references.
    # -------------------------------------------------

    steps = []

    for skill in ordered:

        inputs = contracts.get(
            skill,
            {}
        ).get(
            "inputs",
            {}
        )

        args = {}

        for required_field in inputs:

            required_field = str(
                required_field
            )

            # Root inputs come directly from the user.
            if required_field.lower() in {
                "text",
                "input",
                "query",
                "user_input",
            }:

                # Prefer the most recent compatible output
                # if one exists before this step.
                chosen = None

                for previous_skill in reversed(
                    ordered
                ):

                    if step_numbers[
                        previous_skill
                    ] >= step_numbers[
                        skill
                    ]:
                        continue

                    outputs = contracts.get(
                        previous_skill,
                        {}
                    ).get(
                        "outputs",
                        {}
                    )

                    for produced in outputs:

                        if field_compatible(
                            required_field,
                            produced
                        ) and produced in {
                            "cleaned_text",
                            "normalized_text",
                        }:
                            chosen = (
                                step_numbers[
                                    previous_skill
                                ],
                                produced
                            )
                            break

                    if chosen:
                        break

                if chosen:
                    args[
                        required_field
                    ] = (
                        f"${{step{chosen[0]}."
                        f"{chosen[1]}}}"
                    )
                else:
                    args[
                        required_field
                    ] = "${input}"

                continue

            chosen = None

            for previous_skill in reversed(
                ordered
            ):

                if step_numbers[
                    previous_skill
                ] >= step_numbers[
                    skill
                ]:
                    continue

                outputs = contracts.get(
                    previous_skill,
                    {}
                ).get(
                    "outputs",
                    {}
                )

                for produced in outputs:

                    if field_compatible(
                        required_field,
                        produced
                    ):
                        chosen = (
                            step_numbers[
                                previous_skill
                            ],
                            produced
                        )
                        break

                if chosen:
                    break

            if chosen:
                args[
                    required_field
                ] = (
                    f"${{step{chosen[0]}."
                    f"{chosen[1]}}}"
                )

        steps.append({
            "order": step_numbers[skill],
            "skill": skill,
            "args_template": args,
            "reason": (
                "Selected by capability retrieval "
                "and deterministic dependency resolution."
            )
        })

    plan = {
        "query": user_task,
        "steps": steps,
        "planner": "dependency_solver"
    }

    PLAN_PATH.write_text(
        json.dumps(
            plan,
            ensure_ascii=False,
            indent=2
        ),
        encoding="utf-8"
    )

    return plan


def main():
    import sys

    if len(sys.argv) < 3:
        print(
            'Usage: python dependency_planner.py "task" '
            '"goal1" "goal2" ...'
        )
        return 1

    task = sys.argv[1]
    goals = sys.argv[2:]

    plan = create_plan(
        task,
        goals
    )

    print(
        json.dumps(
            plan,
            ensure_ascii=False,
            indent=2
        )
    )

    return 0 if plan["steps"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
