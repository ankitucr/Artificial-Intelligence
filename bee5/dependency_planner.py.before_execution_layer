PLAN_PATH = MEMORY / "dependency_plan.json"


FIELD_ALIASES = {
    "text": {
        "text",
        "cleaned_text",
        "raw_text",
        "input_text",
    },
    "input": {
        "input",
        "text",
        "cleaned_text",
    },
}


def field_compatible(required, produced):
    required = str(required).lower()
    produced = str(produced).lower()

    if required == produced:
        return True

    aliases = FIELD_ALIASES.get(
        required,
        {required}
    )

    return produced in aliases


def producer_candidates(
    required_field,
    contracts,
    exclude=None
):
    """
    Return skills that can produce a required field.

    Generic root inputs such as 'text', 'input' and 'query'
    are NOT treated as dependency requirements because they
    can come directly from the user.
    """

    required_field = str(
        required_field
    ).lower()

    # These are available from the original user input.
    if required_field in {
        "text",
        "input",
        "query",
        "user_input",
    }:
        return []

    results = []

    for skill, contract in contracts.items():

        if skill == exclude:
            continue

        outputs = contract.get(
            "outputs",
            {}
        )

        for output in outputs:

            if field_compatible(
                required_field,
                output
            ):
                results.append(
                    (skill, output)
                )

    return results


def choose_skill_for_goal(
    goal,
    limit=5
):
    candidates = find_candidates(
        goal,
        limit=limit
    )

    if not candidates:
        return None

    return candidates[0]["skill"]


def build_dependency_graph(
    selected_skills,
    contracts
):
    dependencies = defaultdict(set)

    for skill in selected_skills:

        inputs = contracts.get(
            skill,
            {}
        ).get(
            "inputs",
            {}
        )

        for required_field in inputs:

            # Original user inputs need no producer.
            if str(required_field).lower() in {
                "text",
                "input",
                "query",
                "user_input",
            }:
                continue

            producers = producer_candidates(
                required_field,
                contracts,
                exclude=skill
            )

            selected = [
                item
                for item in producers
                if item[0] in selected_skills
            ]

            if selected:
                producer = selected[0][0]
                dependencies[skill].add(
                    producer
                )

    return dependencies



def apply_semantic_precedence(
    selected_skills,
    dependencies,
    query
):
    """
    Add deterministic semantic ordering for known multi-stage
    workflows.

    This does NOT replace capability dependencies.
    It only adds precedence when the user's task explicitly
    implies an ordered workflow.
    """

    lowered = query.lower()

    # ---------------------------------------------------------
    # Text processing pipeline:
    #
    # clean -> analyze -> report
    # ---------------------------------------------------------

    if (
        "clean" in lowered
        and "analy" in lowered
        and "report" in lowered
    ):
        chain = [
            "text_cleaner",
            "text_analyzer",
            "text_reporter",
        ]

        present = [
            skill
            for skill in chain
            if skill in selected_skills
        ]

        for index in range(1, len(present)):
            previous = present[index - 1]
            current = present[index]

            dependencies[current].add(
                previous
            )

    return dependencies


def topological_order(
    selected_skills,
    dependencies
):
    graph = {
        skill: set(
            dependencies.get(
                skill,
                set()
            )
        )
        for skill in selected_skills
    }

    result = []

    while graph:
        ready = sorted(
            skill
            for skill, deps in graph.items()
            if not deps
        )

        if not ready:
            raise RuntimeError(
                "Cyclic skill dependency detected."
            )

        for skill in ready:
            result.append(skill)
            del graph[skill]

        for deps in graph.values():
            deps.difference_update(
                ready
            )

    return result


