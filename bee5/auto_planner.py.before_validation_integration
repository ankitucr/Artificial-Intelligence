#!/usr/bin/env python3

import json
import subprocess
import sys
from pathlib import Path

from bee5_runtime import LLAMA, MODEL, repair_json, load_registry
from capability_graph import build_graph, find_candidates


ROOT = Path(__file__).resolve().parent
AUTO_PLAN_PATH = ROOT / "memory" / "auto_plan.json"

PLAN_SCHEMA = {
    "type": "object",
    "properties": {
        "query": {"type": "string"},
        "steps": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "order": {"type": "integer"},
                    "skill": {"type": "string"},
                    "args_template": {"type": "object"},
                    "reason": {"type": "string"}
                },
                "required": [
                    "order",
                    "skill",
                    "args_template",
                    "reason"
                ],
                "additionalProperties": False
            }
        }
    },
    "required": ["query", "steps"],
    "additionalProperties": False
}


def build_planning_context(query):
    candidates = find_candidates(
        query,
        limit=8
    )

    registry = load_registry()

    usable = []

    for item in candidates:
        skill = item["skill"]

        if skill not in registry:
            continue

        usable.append({
            "skill": skill,
            "description": item.get(
                "description",
                ""
            ),
            "functions": item.get(
                "functions",
                []
            ),
            "sample_args": item.get(
                "sample_args",
                {}
            ),
            "score": item.get(
                "score",
                0
            ),
            "reliability": item.get(
                "reliability",
                0
            )
        })

    return usable


def deterministic_fallback(query, candidates):
    """
    Safe fallback for common known workflows.
    No invented skills are allowed.
    """
    names = {
        item["skill"]
        for item in candidates
    }

    steps = []

    lowered = query.lower()

    # Known text pipeline.
    if (
        "clean" in lowered
        and "analy" in lowered
        and "report" in lowered
        and {
            "text_cleaner",
            "text_analyzer",
            "text_reporter"
        }.issubset(names)
    ):
        steps = [
            {
                "order": 1,
                "skill": "text_cleaner",
                "args_template": {
                    "text": "${input}"
                },
                "reason": "Clean the input text first."
            },
            {
                "order": 2,
                "skill": "text_analyzer",
                "args_template": {
                    "text": "${previous.cleaned_text}"
                },
                "reason": "Analyze the cleaned text."
            },
            {
                "order": 3,
                "skill": "text_reporter",
                "args_template": {
                    "text": "${previous.text}",
                    "word_count": "${previous.word_count}",
                    "unique_word_count": "${previous.unique_word_count}",
                    "longest_word": "${previous.longest_word}"
                },
                "reason": "Create a report from the analysis."
            }
        ]

    # Single-skill fallback.
    elif candidates:
        first = candidates[0]
        skill = first["skill"]

        sample_args = first.get(
            "sample_args",
            {}
        )

        args_template = {}

        if isinstance(sample_args, dict):
            for key, value in sample_args.items():
                if key in {
                    "text",
                    "input",
                    "input_text",
                    "query"
                }:
                    args_template[key] = "${input}"
                else:
                    args_template[key] = value

        steps = [
            {
                "order": 1,
                "skill": skill,
                "args_template": args_template,
                "reason": (
                    "Best verified skill candidate "
                    "for the requested task."
                )
            }
        ]

    return {
        "query": query,
        "steps": steps
    }


def validate_plan(plan, query):
    if not isinstance(plan, dict):
        return False, "Plan is not an object."

    steps = plan.get(
        "steps"
    )

    if not isinstance(steps, list):
        return False, "Plan steps are not a list."

    registry = load_registry()

    seen_orders = set()

    for expected_order, step in enumerate(
        steps,
        start=1
    ):
        if not isinstance(step, dict):
            return False, f"Step {expected_order} is invalid."

        order = step.get("order")

        if order != expected_order:
            return False, (
                f"Step order mismatch: "
                f"expected {expected_order}, got {order}."
            )

        if order in seen_orders:
            return False, f"Duplicate step order: {order}"

        seen_orders.add(order)

        skill = step.get(
            "skill"
        )

        if not isinstance(skill, str) or not skill:
            return False, (
                f"Step {expected_order} has no skill."
            )

        if skill not in registry:
            return False, (
                f"Unregistered skill requested: {skill}"
            )

        args = step.get(
            "args_template"
        )

        if not isinstance(args, dict):
            return False, (
                f"Step {expected_order} args_template "
                f"must be an object."
            )

    plan["query"] = query

    return True, "OK"


def ask_local_planner(query, candidates):
    context = json.dumps(
        candidates,
        ensure_ascii=False,
        indent=2
    )

    prompt = f"""
You are the BEE5 planning module.

Create a minimal executable plan for the user's task.

USER TASK:
{query}

VERIFIED AVAILABLE SKILLS:
{context}

Rules:
1. Use ONLY exact skills listed above.
2. Never invent a skill.
3. Return ONLY valid JSON.
4. "steps" must be ordered starting at 1.
5. Every step must contain:
   - order
   - skill
   - args_template
   - reason
6. args_template must always be a JSON object.
7. Use "${{input}}" for the original user input when needed.
8. Use "${{previous.field}}" only when the field is produced by the immediately previous step.
9. Prefer the smallest valid plan.
10. If one skill is sufficient, use one step.
""".strip()

    command = [
        str(LLAMA),
        "-m",
        str(MODEL),
        "-p",
        prompt,
        "-n",
        "256",
        "-j",
        json.dumps(
            PLAN_SCHEMA,
            separators=(",", ":")
        ),
        "-st",
        "--no-display-prompt",
        "--single-turn"
    ]

    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        timeout=180
    )

    raw = (
        result.stdout
        + "\n"
        + result.stderr
    ).strip()

    if result.returncode != 0:
        raise RuntimeError(
            raw or "Local planner failed."
        )

    return repair_json(raw)


def create_auto_plan(query):
    build_graph()

    candidates = build_planning_context(
        query
    )

    if not candidates:
        return {
            "query": query,
            "steps": [],
            "planner": "no_candidates"
        }

    try:
        plan = ask_local_planner(
            query,
            candidates
        )

        valid, reason = validate_plan(
            plan,
            query
        )

        if valid:
            plan["planner"] = "local_model"
            plan["candidate_count"] = len(
                candidates
            )

            AUTO_PLAN_PATH.write_text(
                json.dumps(
                    plan,
                    ensure_ascii=False,
                    indent=2
                ),
                encoding="utf-8"
            )

            return plan

    except Exception:
        pass

    fallback = deterministic_fallback(
        query,
        candidates
    )

    valid, reason = validate_plan(
        fallback,
        query
    )

    if not valid:
        return {
            "query": query,
            "steps": [],
            "planner": "fallback_failed",
            "error": reason
        }

    fallback["planner"] = "deterministic_fallback"
    fallback["candidate_count"] = len(
        candidates
    )

    AUTO_PLAN_PATH.write_text(
        json.dumps(
            fallback,
            ensure_ascii=False,
            indent=2
        ),
        encoding="utf-8"
    )

    return fallback


def main():
    if len(sys.argv) < 2:
        print(
            'Usage: python auto_planner.py "task"'
        )
        return 1

    query = " ".join(
        sys.argv[1:]
    )

    plan = create_auto_plan(
        query
    )

    print(
        json.dumps(
            plan,
            ensure_ascii=False,
            indent=2
        )
    )

    return (
        0
        if plan.get("steps")
        else 2
    )


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
