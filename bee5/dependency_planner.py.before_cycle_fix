def create_plan(user_task, goals):
    build_graph()

    contracts = build_all()
    registry = load_registry()

    selected = []

    for goal in goals:

        skill = choose_skill_for_goal(
            goal
        )

        if (
            skill
            and skill in registry
            and skill in contracts
        ):
            if skill not in selected:
                selected.append(skill)

    if not selected:
        return {
            "query": user_task,
            "steps": [],
            "planner": "dependency_solver"
        }

    # Add required producers recursively.
    changed = True

    while changed:
        changed = False

        current = list(selected)

        for skill in current:

            inputs = contracts.get(
                skill,
                {}
            ).get(
                "inputs",
                {}
            )

            for required_field in inputs:

                producers = producer_candidates(
                    required_field,
                    contracts,
                    exclude=skill
                )

                for producer, _ in producers:
                    if producer in registry and producer not in selected:
                        selected.append(
                            producer
                        )
                        changed = True
                        break

    dependencies = build_dependency_graph(
        selected,
        contracts
    )

    ordered = topological_order(
        selected,
        dependencies
    )

    step_numbers = {
        skill: index + 1
        for index, skill in enumerate(
            ordered
        )
    }

    args_templates = build_args_templates(
        ordered,
        contracts,
        step_numbers
    )

    steps = []

    for skill in ordered:
        steps.append({
            "order": step_numbers[skill],
            "skill": skill,
            "args_template": args_templates[
                skill
            ],
            "reason": (
                "Selected by capability retrieval "
                "and dependency resolution."
            )
        })

    plan = {
        "query": user_task,
        "steps": steps,
        "planner": "dependency_solver"
    }

    PLAN_PATH.write_text(
        json.dumps(
            plan,
            ensure_ascii=False,
            indent=2
        ),
        encoding="utf-8"
    )

    return plan


def main():
    import sys

    if len(sys.argv) < 3:
        print(
            'Usage: python dependency_planner.py "task" '
            '"goal1" "goal2" ...'
        )
        return 1

    task = sys.argv[1]
    goals = sys.argv[2:]

    plan = create_plan(
        task,
        goals
    )

    print(
        json.dumps(
            plan,
            ensure_ascii=False,
            indent=2
        )
    )

    return 0 if plan["steps"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
