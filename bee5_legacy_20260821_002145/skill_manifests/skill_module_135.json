  "metadata": {
    "name": "Roman Numeral Converter",
    "capability": "This skill adds the ability to convert integers to Roman numerals",
    "purpose": "This capability is useful for generating Roman numerals for display or calculation purposes",
    "primary_function": "int_to_roman",
    "code": "def int_to_roman(num):\n    val = [\n        1000, 900, 500, 400,\n        100, 90, 50, 40,\n        10, 9, 5, 4,\n        1\n        ]\n    syb = [\n        \"M\", \"CM\", \"D\", \"CD\",\n        \"C\", \"XC\", \"L\", \"XL\",\n        \"X\", \"IX\", \"V\", \"IV\",\n        \"I\"\n        ]\n    roman_num = ''\n    i = 0\n    while  num > 0:\n        for _ in range(num // val[i]):\n            roman_num += syb[i]\n            num -= val[i]\n        i += 1\n    return roman_num",
