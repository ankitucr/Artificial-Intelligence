    "name": "prime_factorizer",
    "capability": "This skill adds the ability to factorize a given integer into its prime factors.",
    "purpose": "Prime factorization is useful in various mathematical and computational applications, such as cryptography and coding theory.",
    "primary_function": "prime_factors",
    "code": "def prime_factors(n):\n    i = 2\n    factors = {}\n    while i * i <= n:\n        if n % i:\n            i += 1\n        else:\n            n //= i\n            factors[i] = factors.get(i, 0) + 1\n    if n > 1:\n        factors[n] = factors.get(n, 0) + 1\n    return factors",
