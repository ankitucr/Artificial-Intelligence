  for (const text in knowledgeGraph) {
    const knowledgeGraphTokens = knowledgeGraph[text];
    if (knowledgeGraphTokens.includes(token)) {
      const relatedTexts = findRelatedTexts(text);
      relatedTexts.forEach(t => {
