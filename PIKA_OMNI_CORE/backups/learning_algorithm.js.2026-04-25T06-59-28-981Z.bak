  const generatedText = [];
  for (const token of promptTokens) {
    const similarTokens = findSimilarTokens(token);
    generatedText.push(...similarTokens);
    const relatedTokens = findRelatedTokens(token);
    generatedText.push(...relatedTokens);
  }
  return generatedText.join(' ');
}

