const express = require('express');
const app = express();
const natural = require('natural');
const WordTokenizer = new natural.WordTokenizer();
const TfIdf = new natural.TfIdf();
const PorterStemmer = natural.PorterStemmer;
const stopwords = require('stopwords').english;
const _ = require('lodash');

let knowledgeGraph = {};

app.use(express.json());

app.post('/train', (req, res) => {
  const { text } = req.body;
  const tokens = WordTokenizer.tokenize(text);
  const filteredTokens = tokens.filter(token => !stopwords.includes(token.toLowerCase()) && token.length > 2);
  const stemmedTokens = filteredTokens.map(token => PorterStemmer.stem(token));
  TfIdf.addDocument(stemmedTokens.join(' '));
  knowledgeGraph[text] = stemmedTokens;
  res.send('Training successful');
});

app.post('/query', (req, res) => {
  const { query } = req.body;
  const queryTokens = WordTokenizer.tokenize(query);
  const filteredQueryTokens = queryTokens.filter(token => !stopwords.includes(token.toLowerCase()) && token.length > 2);
  const stemmedQueryTokens = filteredQueryTokens.map(token => PorterStemmer.stem(token));
  const queryTfIdf = TfIdf.tfidf(stemmedQueryTokens.join(' '), 1);
  const similarityScores = {};
  for (const text in knowledgeGraph) {
    const similarityScore = calculateSimilarity(queryTfIdf, knowledgeGraph[text]);
    similarityScores[text] = similarityScore;
  }
  const sortedSimilarityScores = _.sortBy(Object.entries(similarityScores), 1).reverse();
  res.send(sortedSimilarityScores);
});

function calculateSimilarity(queryTfIdf, knowledgeGraphTokens) {
  const queryTokens = Object.keys(queryTfIdf);
  const knowledgeGraphTokenSet = new Set(knowledgeGraphTokens);
  let similarityScore = 0;
  for (const token of queryTokens) {
    if (knowledgeGraphTokenSet.has(token)) {
      similarityScore += queryTfIdf[token];
    }
  }
  return similarityScore / queryTokens.length;
}

app.post('/expand', (req, res) => {
  const { text } = req.body;
  const tokens = WordTokenizer.tokenize(text);
  const filteredTokens = tokens.filter(token => !stopwords.includes(token.toLowerCase()) && token.length > 2);
  const stemmedTokens = filteredTokens.map(token => PorterStemmer.stem(token));
  const expandedTokens = expandKnowledgeGraph(stemmedTokens);
  res.send(expandedTokens);
});

function expandKnowledgeGraph(tokens) {
  const expandedTokens = new Set();
  for (const token of tokens) {
    const similarTokens = findSimilarTokens(token);
    similarTokens.forEach(t => expandedTokens.add(t));
    const relatedTokens = findRelatedTokens(token);
    relatedTokens.forEach(t => expandedTokens.add(t));
    const newTokens = findNewTokens(token);
    newTokens.forEach(t => expandedTokens.add(t));
  }
  return Array.from(expandedTokens);
}

function findSimilarTokens(token) {
  const similarTokens = new Set();
  for (const text in knowledgeGraph) {
    const knowledgeGraphTokens = knowledgeGraph[text];
    if (knowledgeGraphTokens.includes(token)) {
      knowledgeGraphTokens.forEach(t => similarTokens.add(t));
    }
  }
  return Array.from(similarTokens);
}

function findRelatedTokens(token) {
  const relatedTokens = new Set();
  for (const text in knowledgeGraph) {
    const knowledgeGraphTokens = knowledgeGraph[text];
    if (knowledgeGraphTokens.includes(token)) {
      const relatedTexts = findRelatedTexts(text);
      relatedTexts.forEach(t => {
        const relatedKnowledgeGraphTokens = knowledgeGraph[t];
        relatedKnowledgeGraphTokens.forEach(r => relatedTokens.add(r));
      });
    }
  }
  return Array.from(relatedTokens);
}

function findRelatedTexts(text) {
  const relatedTexts = new Set();
  for (const t in knowledgeGraph) {
    if (t !== text) {
      const similarityScore = calculateTextSimilarity(text, t);
      if (similarityScore > 0.5) {
        relatedTexts.add(t);
      }
    }
  }
  return Array.from(relatedTexts);
}

function calculateTextSimilarity(text1, text2) {
  const tokens1 = knowledgeGraph[text1];
  const tokens2 = knowledgeGraph[text2];
  const similarityScore = calculateSimilarity(tokens1, tokens2);
  return similarityScore;
}

function calculateSimilarity(tokens1, tokens2) {
  const tokenSet1 = new Set(tokens1);
  const tokenSet2 = new Set(tokens2);
  let similarityScore = 0;
  for (const token of tokenSet1) {
    if (tokenSet2.has(token)) {
      similarityScore++;
    }
  }
  return similarityScore / Math.max(tokenSet1.size, tokenSet2.size);
}

app.post('/generate', (req, res) => {
  const { prompt } = req.body;
  const promptTokens = WordTokenizer.tokenize(prompt);
  const filteredPromptTokens = promptTokens.filter(token => !stopwords.includes(token.toLowerCase()) && token.length > 2);
  const stemmedPromptTokens = filteredPromptTokens.map(token => PorterStemmer.stem(token));
  const generatedText = generateText(stemmedPromptTokens);
  res.send(generatedText);
});

function generateText(promptTokens) {
  const generatedText = [];
  for (const token of promptTokens) {
    const similarTokens = findSimilarTokens(token);
    generatedText.push(...similarTokens);
    const relatedTokens = findRelatedTokens(token);
    generatedText.push(...relatedTokens);
  }
  return generatedText.join(' ');
}

app.post('/retention', (req, res) => {
  const { text } = req.body;
  const tokens = WordTokenizer.tokenize(text);
  const filteredTokens = tokens.filter(token => !stopwords.includes(token.toLowerCase()) && token.length > 2);
  const stemmedTokens = filteredTokens.map(token => PorterStemmer.stem(token));
  const retainedTokens = retainKnowledge(stemmedTokens);
  res.send(retainedTokens);
});

function retainKnowledge(tokens) {
  const retainedTokens = new Set();
  for (const token of tokens) {
    const similarTokens = findSimilarTokens(token);
    similarTokens.forEach(t => retainedTokens.add(t));
    const relatedTokens = findRelatedTokens(token);
    relatedTokens.forEach(t => retainedTokens.add(t));
  }
  return Array.from(retainedTokens);
}

app.post('/evolve', (req, res) => {
  const { text } = req.body;
  const tokens = WordTokenizer.tokenize(text);
  const filteredTokens = tokens.filter(token => !stopwords.includes(token.toLowerCase()) && token.length > 2);
  const stemmedTokens = filteredTokens.map(token => PorterStemmer.stem(token));
  const evolvedTokens = evolveKnowledgeGraph(stemmedTokens);
  res.send(evolvedTokens);
});

function evolveKnowledgeGraph(tokens) {
  const evolvedTokens = new Set();
  for (const token of tokens) {
    const similarTokens = findSimilarTokens(token);
    similarTokens.forEach(t => evolvedTokens.add(t));
    const relatedTokens = findRelatedTokens(token);
    relatedTokens.forEach(t => evolvedTokens.add(t));
    const newTokens = findNewTokens(token);
    newTokens.forEach(t => evolvedTokens.add(t));
  }
  return Array.from(evolvedTokens);
}

function findNewTokens(token) {
  const newTokens = new Set();
  for (const text in knowledgeGraph) {
    const knowledgeGraphTokens = knowledgeGraph[text];
    if (!knowledgeGraphTokens.includes(token)) {
      knowledgeGraphTokens.forEach(t => newTokens.add(t));
    }
  }
  return Array.from(newTokens);
}

app.post('/optimize', (req, res) => {
  const { text } = req.body;
  const tokens = WordTokenizer.tokenize(text);
  const filteredTokens = tokens.filter(token => !stopwords.includes(token.toLowerCase()) && token.length > 2);
  const stemmedTokens = filteredTokens.map(token => PorterStemmer.stem(token));
  const optimizedTokens = optimizeKnowledgeGraph(stemmedTokens);
  res.send(optimizedTokens);
});

function optimizeKnowledgeGraph(tokens) {
  const optimizedTokens = new Set();
  for (const token of tokens) {
    const similarTokens = findSimilarTokens(token);
    similarTokens.forEach(t => optimizedTokens.add(t));
    const relatedTokens = findRelatedTokens(token);
    relatedTokens.forEach(t => optimizedTokens.add(t));
    const newTokens = findNewTokens(token);
    newTokens.forEach(t => optimizedTokens.add(t));
    const optimizedToken = optimizeToken(token);
    optimizedTokens.add(optimizedToken);
  }
  return Array.from(optimizedTokens);
}

function optimizeToken(token) {
  const optimizedToken = token;
  for (const t in knowledgeGraph) {
    const knowledgeGraphTokens = knowledgeGraph[t];
    if (knowledgeGraphTokens.includes(token)) {
      const optimizedKnowledgeGraphTokens = optimizeKnowledgeGraph(knowledgeGraphTokens);
      optimizedToken = optimizedKnowledgeGraphTokens[0];
    }
  }
  return optimizedToken;
}

