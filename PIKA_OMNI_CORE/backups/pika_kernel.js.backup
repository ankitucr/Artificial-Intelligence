// 🧬 AUTONOMOUS MUTATION: Enhance natural language processing capabilities to improve conversational accuracy and context understanding.
function contextualizeResponse(query, recognizedEntities, detectedIntentions) {
  let contextualizedResponse = knowledgeBase.default;
  let entityRecognitionResponse = knowledgeBase.entity_recognition + recognizedEntities.join(", ");
  let intentDetectionResponse = knowledgeBase.intent_detection + detectedIntentions.join(", ");

  if (detectedIntentions.includes("greeting")) {
    contextualizedResponse = knowledgeBase.greeting;
  } else if (detectedIntentions.includes("introduction")) {
    contextualizedResponse = knowledgeBase.introduction;
  } else if (detectedIntentions.includes("entity_recognition")) {
    contextualizedResponse = entityRecognitionResponse;
  } else if (detectedIntentions.includes("intent_detection")) {
    contextualizedResponse = intentDetectionResponse;
  }

  if (recognizedEntities.length > 0 && detectedIntentions.length > 0) {
    contextualizedResponse += " Additionally, I've identified the following entities: " + recognizedEntities.join(", ") + " and detected the following intentions: " + detectedIntentions.join(", ");
  }

  let contextualizedEntities = {};
  recognizedEntities.forEach(entity => {
    contextualizedEntities[entity] = knowledgeGraph.entities[entity];
  });

  let contextualizedIntentions = {};
  detectedIntentions.forEach(intention => {
    contextualizedIntentions[intention] = knowledgeGraph.intentions[intention];
  });

  return { response: contextualizedResponse, entities: contextualizedEntities, intentions: contextualizedIntentions };
}