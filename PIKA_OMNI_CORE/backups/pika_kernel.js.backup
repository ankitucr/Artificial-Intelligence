const express = require('express');
const app = express();
const port = 3000;
const natural = require('natural');
const wordnet = new natural.WordNet();
const stopwords = require('stopwords').english;
const lemmatizer = require('wink-lemmatizer');

app.use(express.json());

let knowledgeBase = {
  "greeting": "Hello, how can I assist you today?",
  "introduction": "I'm an AI designed to provide information and answer questions.",
  "default": "I didn't understand your question. Please try rephrasing.",
  "entity_recognition": "I've identified the following entities: ",
  "intent_detection": "I've detected the following intentions: "
};

let knowledgeGraph = {
  "entities": {
    "person": ["human", "individual", "being"],
    "organization": ["company", "firm", "institution"],
    "location": ["place", "city", "country"]
  },
  "intentions": {
    "greeting": ["hello", "hi", "hey"],
    "introduction": ["who are you", "what is your purpose", "what do you do"],
    "entity_recognition": ["what is", "who is", "where is"],
    "intent_detection": ["why", "how", "what"]
  }
};

let entityRecognitionModel = (query) => {
  let tokens = query.toLowerCase().split(" ");
  tokens = tokens.filter(token => !stopwords.includes(token));
  tokens = tokens.map(token => lemmatizer.lemmatize(token));
  let recognizedEntities = [];

  Object.keys(knowledgeGraph.entities).forEach(entity => {
    knowledgeGraph.entities[entity].forEach(keyword => {
      if (tokens.includes(keyword)) {
        recognizedEntities.push(entity);
      }
    });
  });

  return recognizedEntities;
};

let intentDetectionModel = (query) => {
  let tokens = query.toLowerCase().split(" ");
  tokens = tokens.filter(token => !stopwords.includes(token));
  tokens = tokens.map(token => lemmatizer.lemmatize(token));
  let matchedIntentions = Object.keys(knowledgeGraph.intentions).filter(intention => {
    return knowledgeGraph.intentions[intention].some(keyword => tokens.includes(keyword));
  });

  return matchedIntentions;
};

app.post('/query', (req, res) => {
  const query = req.body.query;
  let response = knowledgeBase.default;

  let recognizedEntities = entityRecognitionModel(query);
  let detectedIntentions = intentDetectionModel(query);

  if (detectedIntentions.includes("greeting")) {
    response = knowledgeBase.greeting;
  } else if (detectedIntentions.includes("introduction")) {
    response = knowledgeBase.introduction;
  } else if (detectedIntentions.includes("entity_recognition")) {
    response = knowledgeBase.entity_recognition + recognizedEntities.join(", ");
  } else if (detectedIntentions.includes("intent_detection")) {
    response = knowledgeBase.intent_detection + detectedIntentions.join(", ");
  }

  res.json({ response: response, entities: recognizedEntities, intentions: detectedIntentions });
});

app.listen(port, () => {
  console.log(`Server listening on port ${port}`);
});

// 🧬 AUTONOMOUS MUTATION: to enhance natural language processing capabilities and improve response accuracy
function enhanceResponseAccuracy(query, recognizedEntities, detectedIntentions) {
  let enhancedResponse = knowledgeBase.default;
  let entityRecognitionResponse = knowledgeBase.entity_recognition + recognizedEntities.join(", ");
  let intentDetectionResponse = knowledgeBase.intent_detection + detectedIntentions.join(", ");

  if (detectedIntentions.includes("greeting")) {
    enhancedResponse = knowledgeBase.greeting;
  } else if (detectedIntentions.includes("introduction")) {
    enhancedResponse = knowledgeBase.introduction;
  } else if (detectedIntentions.includes("entity_recognition")) {
    enhancedResponse = entityRecognitionResponse;
  } else if (detectedIntentions.includes("intent_detection")) {
    enhancedResponse = intentDetectionResponse;
  }

  if (recognizedEntities.length > 0 && detectedIntentions.length > 0) {
    enhancedResponse += " Additionally, I've identified the following entities: " + recognizedEntities.join(", ") + " and detected the following intentions: " + detectedIntentions.join(", ");
  }

  return enhancedResponse;
}

// 🧬 AUTONOMOUS MUTATION: Improve natural language processing capabilities and enhance knowledge graph updates for more accurate and informative responses.
function updateKnowledgeGraph(query, recognizedEntities, detectedIntentions) {
  let updatedEntities = knowledgeGraph.entities;
  let updatedIntentions = knowledgeGraph.intentions;

  recognizedEntities.forEach(entity => {
    if (!updatedEntities[entity]) {
      updatedEntities[entity] = [];
    }
    let tokens = query.toLowerCase().split(" ");
    tokens = tokens.filter(token => !stopwords.includes(token));
    tokens = tokens.map(token => lemmatizer.lemmatize(token));
    tokens.forEach(token => {
      if (!updatedEntities[entity].includes(token)) {
        updatedEntities[entity].push(token);
      }
    });
  });

  detectedIntentions.forEach(intention => {
    if (!updatedIntentions[intention]) {
      updatedIntentions[intention] = [];
    }
    let tokens = query.toLowerCase().split(" ");
    tokens = tokens.filter(token => !stopwords.includes(token));
    tokens = tokens.map(token => lemmatizer.lemmatize(token));
    tokens.forEach(token => {
      if (!updatedIntentions[intention].includes(token)) {
        updatedIntentions[intention].push(token);
      }
    });
  });

  knowledgeGraph.entities = updatedEntities;
  knowledgeGraph.intentions = updatedIntentions;
}

// 🧬 AUTONOMOUS MUTATION: To enhance knowledge graph expansion and improve response generation capabilities.
function expandKnowledgeGraph(query, recognizedEntities, detectedIntentions) {
  let expandedGraph = knowledgeGraph;
  let newEntities = {};
  let newIntentions = {};

  recognizedEntities.forEach(entity => {
    if (!expandedGraph.entities[entity]) {
      newEntities[entity] = [];
    }
    let tokens = query.toLowerCase().split(" ");
    tokens = tokens.filter(token => !stopwords.includes(token));
    tokens = tokens.map(token => lemmatizer.lemmatize(token));
    tokens.forEach(token => {
      if (!expandedGraph.entities[entity].includes(token)) {
        newEntities[entity].push(token);
      }
    });
  });

  detectedIntentions.forEach(intention => {
    if (!expandedGraph.intentions[intention]) {
      newIntentions[intention] = [];
    }
    let tokens = query.toLowerCase().split(" ");
    tokens = tokens.filter(token => !stopwords.includes(token));
    tokens = tokens.map(token => lemmatizer.lemmatize(token));
    tokens.forEach(token => {
      if (!expandedGraph.intentions[intention].includes(token)) {
        newIntentions[intention].push(token);
      }
    });
  });

  Object.keys(newEntities).forEach(entity => {
    if (!expandedGraph.entities[entity]) {
      expandedGraph.entities[entity] = newEntities[entity];
    } else {
      expandedGraph.entities[entity] = expandedGraph.entities[entity].concat(newEntities[entity]);
    }
  });

  Object.keys(newIntentions).forEach(intention => {
    if (!expandedGraph.intentions[intention]) {
      expandedGraph.intentions[intention] = newIntentions[intention];
    } else {
      expandedGraph.intentions[intention] = expandedGraph.intentions[intention].concat(newIntentions[intention]);
    }
  });

  knowledgeGraph = expandedGraph;
}

// 🧬 AUTONOMOUS MUTATION: Enhance natural language processing and knowledge graph integration to improve conversational accuracy and contextual understanding.
function generateContextualResponse(query, recognizedEntities, detectedIntentions) {
  let contextualResponse = knowledgeBase.default;
  let entityRecognitionResponse = knowledgeBase.entity_recognition + recognizedEntities.join(", ");
  let intentDetectionResponse = knowledgeBase.intent_detection + detectedIntentions.join(", ");

  if (detectedIntentions.includes("greeting")) {
    contextualResponse = knowledgeBase.greeting;
  } else if (detectedIntentions.includes("introduction")) {
    contextualResponse = knowledgeBase.introduction;
  } else if (detectedIntentions.includes("entity_recognition")) {
    contextualResponse = entityRecognitionResponse;
  } else if (detectedIntentions.includes("intent_detection")) {
    contextualResponse = intentDetectionResponse;
  }

  if (recognizedEntities.length > 0 && detectedIntentions.length > 0) {
    contextualResponse += " Additionally, I've identified the following entities: " + recognizedEntities.join(", ") + " and detected the following intentions: " + detectedIntentions.join(", ");
  }

  updateKnowledgeGraph(query, recognizedEntities, detectedIntentions);
  expandKnowledgeGraph(query, recognizedEntities, detectedIntentions);

  return contextualResponse;
}

// 🧬 AUTONOMOUS MUTATION: to enhance knowledge graph traversal and improve overall response accuracy
function traverseKnowledgeGraph(query, recognizedEntities, detectedIntentions) {
  let graphTraversalResponse = knowledgeBase.default;
  let entityRecognitionResponse = knowledgeBase.entity_recognition + recognizedEntities.join(", ");
  let intentDetectionResponse = knowledgeBase.intent_detection + detectedIntentions.join(", ");

  if (detectedIntentions.includes("greeting")) {
    graphTraversalResponse = knowledgeBase.greeting;
  } else if (detectedIntentions.includes("introduction")) {
    graphTraversalResponse = knowledgeBase.introduction;
  } else if (detectedIntentions.includes("entity_recognition")) {
    graphTraversalResponse = entityRecognitionResponse;
  } else if (detectedIntentions.includes("intent_detection")) {
    graphTraversalResponse = intentDetectionResponse;
  }

  if (recognizedEntities.length > 0 && detectedIntentions.length > 0) {
    graphTraversalResponse += " Additionally, I've identified the following entities: " + recognizedEntities.join(", ") + " and detected the following intentions: " + detectedIntentions.join(", ");
  }

  let traversedEntities = {};
  recognizedEntities.forEach(entity => {
    traversedEntities[entity] = knowledgeGraph.entities[entity];
  });

  let traversedIntentions = {};
  detectedIntentions.forEach(intention => {
    traversedIntentions[intention] = knowledgeGraph.intentions[intention];
  });

  graphTraversalResponse += " The traversed entities are: " + Object.keys(traversedEntities).join(", ") + " and the traversed intentions are: " + Object.keys(traversedIntentions).join(", ");

  return graphTraversalResponse;
}

