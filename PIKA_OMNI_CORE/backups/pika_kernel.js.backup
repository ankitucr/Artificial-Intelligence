function optimizeKnowledgeGraphTraversal(query, recognizedEntities, detectedIntentions) {
  let optimizedResponse = knowledgeBase.default;
  let entityRecognitionResponse = knowledgeBase.entity_recognition + recognizedEntities.join(", ");
  let intentDetectionResponse = knowledgeBase.intent_detection + detectedIntentions.join(", ");

  if (detectedIntentions.includes("greeting")) {
