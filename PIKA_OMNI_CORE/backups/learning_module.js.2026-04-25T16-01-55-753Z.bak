const express = require('express');
const app = express();
const { v4: uuidv4 } = require('uuid');
const { Graph, Node, Edge } = require('graphology');
const graph = new Graph();

class KnowledgeGraph {
  constructor() {
    this.graph = graph;
  }

  addNode(nodeId, nodeData) {
    if (!this.graph.hasNode(nodeId)) {
      this.graph.addNode(nodeId, nodeData);
    }
  }

  addEdge(edgeId, source, target, edgeData) {
    if (!this.graph.hasEdge(edgeId)) {
      this.graph.addEdge(edgeId, source, target, edgeData);
    }
  }

  expandGraph(newNodeData, newEdgeData) {
    const newNodeId = uuidv4();
    this.addNode(newNodeId, newNodeData);

    newEdgeData.forEach((edge) => {
      const edgeId = uuidv4();
      this.addEdge(edgeId, newNodeId, edge.target, edge.data);
    });
  }

  adaptToDynamicEnvironment(updatedNodeData, updatedEdgeData) {
    updatedNodeData.forEach((node) => {
      if (this.graph.hasNode(node.id)) {
        this.graph.setNodeAttribute(node.id, 'data', node.data);
      }
    });

    updatedEdgeData.forEach((edge) => {
      if (this.graph.hasEdge(edge.id)) {
        this.graph.setEdgeAttribute(edge.id, 'data', edge.data);
      }
    });
  }

  queryGraph(query) {
    const results = [];
    this.graph.forEachNode((node) => {
      if (node.data.includes(query)) {
        results.push(node);
      }
    });
    return results;
  }

  getShortestPath(source, target) {
    const shortestPath = this.graph.getShortestPath(source, target);
    return shortestPath;
  }

  getNeighbors(nodeId) {
    const neighbors = this.graph.getNeighbors(nodeId);
    return neighbors;
  }

  getGraphSize() {
    return this.graph.order;
  }

  getGraphDensity() {
    return this.graph.size / (this.graph.order * (this.graph.order - 1));
  }

  getCentrality(nodeId) {
    const centrality = this.graph.getCentrality(nodeId);
    return centrality;
  }

  getClusterCoefficient(nodeId) {
    const clusterCoefficient = this.graph.getClusterCoefficient(nodeId);
    return clusterCoefficient;
  }

  getCommunityStructure() {
    const communityStructure = this.graph.getCommunityStructure();
    return communityStructure;
  }

  getGraphData() {
    const graphData = {
      nodes: this.graph.nodes(),
      edges: this.graph.edges(),
    };
    return graphData;
  }

  getGraphStatistics() {
    const graphStatistics = {
      nodes: this.graph.order,
      edges: this.graph.size,
      density: this.getGraphDensity(),
    };
    return graphStatistics;
  }

  getConnectedComponents() {
    const connectedComponents = this.graph.getConnectedComponents();
    return connectedComponents;
  }

  getStronglyConnectedComponents() {
    const stronglyConnectedComponents = this.graph.getStronglyConnectedComponents();
    return stronglyConnectedComponents;
  }
}

const knowledgeGraph = new KnowledgeGraph();

app.use(express.json());

app.post('/expand-graph', (req, res) => {
  try {
    const newNodeData = req.body.newNodeData;
    const newEdgeData = req.body.newEdgeData;
    knowledgeGraph.expandGraph(newNodeData, newEdgeData);
    res.send('Graph expanded successfully');
  } catch (error) {
    res.status(500).send('Error expanding graph: ' + error.message);
  }
});

app.post('/adapt-to-dynamic-environment', (req, res) => {
  try {
    const updatedNodeData = req.body.updatedNodeData;
    const updatedEdgeData = req.body.updatedEdgeData;
    knowledgeGraph.adaptToDynamicEnvironment(updatedNodeData, updatedEdgeData);
    res.send('Graph adapted to dynamic environment successfully');
  } catch (error) {
    res.status(500).send('Error adapting to dynamic environment: ' + error.message);
  }
});

app.get('/query-graph', (req, res) => {
