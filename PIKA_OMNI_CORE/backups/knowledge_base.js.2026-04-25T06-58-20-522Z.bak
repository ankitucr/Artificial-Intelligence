}

function updateEntityRelationships(entityId, newRelationships) {
  for (let relationship of expandedDomainKnowledge.relationships) {
    if (relationship.entity1Id == entityId || relationship.entity2Id == entityId) {
      let index = expandedDomainKnowledge.relationships.indexOf(relationship);
      if (index !== -1) {
        expandedDomainKnowledge.relationships.splice(index, 1);
      }
    }
  }
  for (let newRelationship of newRelationships) {
    expandedDomainKnowledge.relationships.push(newRelationship);
  }
}

function updateKnowledgeGraph(entityId, newAttributes, newRelationships) {
  updateEntityAttributes(entityId, newAttributes);
  updateEntityRelationships(entityId, newRelationships);
}

// 🧬 AUTONOMOUS MUTATION: to enhance semantic reasoning and improve knowledge graph updates for more efficient information retrieval and generation.
function appendNewRelationships(newRelationships) {
  for (let relationship of newRelationships) {
    let existingRelation = expandedDomainKnowledge.relationships.find(rel => rel.entity1Id == relationship.entity1Id && rel.entity2Id == relationship.entity2Id && rel.type == relationship.type);
    if (!existingRelation) {
      expandedDomainKnowledge.relationships.push(relationship);
    } else {
      existingRelation.strength = relationship.strength;
    }
  }
}

