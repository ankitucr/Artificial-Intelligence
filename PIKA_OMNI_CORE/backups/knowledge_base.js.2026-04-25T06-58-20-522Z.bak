function expandKnowledgeGraph(entityId) {
  let entity = expandedDomainKnowledge.entities.find(entity => entity.id == entityId);
  if (entity) {
    let relatedEntities = [];
    for (let relationship of expandedDomainKnowledge.relationships) {
      if (relationship.entity1Id == entityId) {
        relatedEntities.push(expandedDomainKnowledge.entities.find(e => e.id == relationship.entity2Id));
      } else if (relationship.entity2Id == entityId) {
        relatedEntities.push(expandedDomainKnowledge.entities.find(e => e.id == relationship.entity1Id));
      }
    }
    return relatedEntities;
  } else {
    return [];
  }
}

function enhanceSemanticReasoning(rules) {
  for (let rule of rules) {
    let existingRule = enhancedSemanticReasoning.rules.find(r => r.pattern == rule.pattern);
    if (existingRule) {
      existingRule.conclusion = rule.conclusion;
      existingRule.confidence = rule.confidence;
    } else {
      enhancedSemanticReasoning.rules.push(rule);
    }
  }
  return enhancedSemanticReasoning.rules;
}

