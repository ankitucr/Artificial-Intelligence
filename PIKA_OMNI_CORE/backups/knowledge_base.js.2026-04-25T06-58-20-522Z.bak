    entity.attributes = newAttributes;
    for (let relationship of newRelationships) {
      let existingRelation = expandedDomainKnowledge.relationships.find(rel => (rel.entity1Id == entityId && rel.entity2Id == relationship.entity2Id) || (rel.entity2Id == entityId && rel.entity1Id == relationship.entity2Id));
      if (existingRelation) {
        existingRelation.type = relationship.type;
        existingRelation.strength = relationship.strength;
      } else {
        expandedDomainKnowledge.relationships.push(relationship);
      }
    }
    return entity;
  } else {
    return null;
  }
}

