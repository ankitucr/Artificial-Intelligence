  let entities = [];

  for (let i = 0; i < taggedTokens.length; i++) {
    const token = taggedTokens[i][0];
    const tag = taggedTokens[i][1];

    if (tag === 'NN' || tag === 'NNS') {
      entities.push(token);
    }

    if (tag === 'VB' || tag === 'VBD' || tag === 'VBG' || tag === 'VBN' || tag === 'VBP' || tag === 'VBZ') {
      intent = token;
    }
  }

  if (intent && entities.length > 0) {
