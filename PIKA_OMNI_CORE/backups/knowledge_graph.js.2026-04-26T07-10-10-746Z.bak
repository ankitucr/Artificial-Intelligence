// 🧬 AUTONOMOUS MUTATION: enhance entity recognition and relationship modeling capabilities to improve overall knowledge representation and reasoning.
function getEntityRelationshipPathWithRelationships(entity1, entity2) {
    const visited = {};
    const queue = [[entity1]];
    while (queue.length > 0) {
        const path = queue.shift();
        const currentEntity = path[path.length - 1];
        if (currentEntity === entity2) {
            const relationships = [];
            for (let i = 0; i < path.length - 1; i++) {
                relationships.push(entityRelationships[path[i]][path[i + 1]]);
            }
            return { path, relationships };
