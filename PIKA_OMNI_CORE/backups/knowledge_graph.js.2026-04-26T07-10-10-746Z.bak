function enhanceRelationshipMapping(entity1, entity2, relationship) {
    const enhancedRelationship = {};
    if (relationship.type === 'causal') {
        enhancedRelationship.direction = relationship.direction;
        enhancedRelationship.strength = relationship.strength;
    } else if (relationship.type === 'correlational') {
        enhancedRelationship.correlation = relationship.correlation;
        enhancedRelationship.significance = relationship.significance;
    } else if (relationship.type === 'associative') {
        enhancedRelationship.association = relationship.association;
        enhancedRelationship.confidence = relationship.confidence;
    }
    return enhancedRelationship;
}

