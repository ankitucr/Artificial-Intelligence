function mapEntityRelationships(entity1, entity2) {
    const path = inferEntityRelationshipPath(entity1, entity2);
    const shortestPath = getShortestEntityRelationshipPath(entity1, entity2);
    const relationship = entityRelationships[entity1] && entityRelationships[entity1][entity2];
    const mappedRelationship = {
        entity1: entity1,
        entity2: entity2,
        path: path,
        shortestPath: shortestPath,
        relationship: relationship
    };
    return mappedRelationship;
}

